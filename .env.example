# Копировать в .env и заполнить своими значениями. Файл .env в git НЕ коммитится.
# Строка подключения к PostgreSQL:
#   postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БД
DATABASE_URL=postgres://transport:СМЕНИ_ПАРОЛЬ@localhost:5432/transport

# Порт бэкенда (nginx проксирует /api на этот порт)
PORT=3000

# Срок жизни сессии в днях
SESSION_TTL_DAYS=30

# Разрешённый источник (для продакшена лучше указать свой домен)
ALLOWED_ORIGIN=*

# Для создания первого админа (node scripts/create-admin.cjs)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=СМЕНИ_ПАРОЛЬ_АДМИНА
